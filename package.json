{
  "name": "sublevel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ./index.html --port 3210 --console",
    "gate": "bun check --no-script && bun fmt --check --no-script && bun test",
    "e2e": "bun tools/e2e.ts",
    "solve": "bun tools/solve.ts",
    "tour": "bun tools/tour.ts",
    "fuzz": "bun tools/solve.ts --count 20 --from 1 --parallel 4",
    "check-seed": "bun tools/check-seed.ts",
    "map": "bun tools/map.ts",
    "deploy": "bun tools/deploy.ts",
    "dist": "bun build --compile --target=browser ./index.html --outdir=dist"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
